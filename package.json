{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "headless": "tsx src/headless/cli.ts",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start": "vite build --logLevel error && node scripts/server.mjs",
    "soak": "tsx --expose-gc src/headless/soak.ts",
    "bench": "vite build --logLevel error && node scripts/bench.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
